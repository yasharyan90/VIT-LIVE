# VIT Live backend configuration — copy to .env and adjust. Never commit real secrets.
APP_ENV=development
PORT=8080

DATABASE_URL=postgres://postgres:devpass@localhost:5432/vitlive?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
VOTE_HMAC_SECRET=change-me-to-a-different-long-random-string

# Comma-separated list of allowed signup email domains
ALLOWED_EMAIL_DOMAINS=vitbhopal.ac.in,vitstudent.ac.in,vit.ac.in

UPLOADS_DIR=./uploads

# Seeded super admin (created on first boot if missing)
SUPERADMIN_EMAIL=admin@vit.ac.in
SUPERADMIN_PASSWORD=admin12345

# Optional: SMTP for real OTP email (dev logs OTPs to console when unset)
#SMTP_HOST=smtp.sendgrid.net
#SMTP_PORT=587
#SMTP_USER=apikey
#SMTP_PASS=
#SMTP_FROM=VIT Live <no-reply@vitlive.app>

# Optional: FCM push (path to a Firebase service-account JSON file)
#FCM_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# Optional: S3-compatible object storage for uploads (local ./uploads when unset)
#S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#S3_BUCKET=vitlive-uploads
#S3_REGION=auto
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_PUBLIC_URL=https://cdn.example.com
